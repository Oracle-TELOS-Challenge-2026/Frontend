{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "functions": { "api/chat-ws.ts": { "maxDuration": 300, "regions": ["icn1"] } },
  "rewrites": [
    { "source": "/api/v1/chatting/ws", "destination": "/api/chat-ws" },
